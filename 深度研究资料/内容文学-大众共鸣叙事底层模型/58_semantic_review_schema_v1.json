{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_review_v1",
  "title": "Semantic Review Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "classification",
    "decision",
    "confidence",
    "target_domain",
    "target_state_id",
    "before",
    "proposed_after",
    "transition_class",
    "evidence",
    "reason"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "objective_fact",
        "character_belief",
        "misunderstanding",
        "emotion_only",
        "actual_state_change",
        "commitment",
        "no_state_change",
        "ambiguous"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "escalate"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "target_domain": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "world",
        "knowledge",
        "boundary",
        "relationship",
        "competence",
        "identity",
        "resource",
        "arc",
        "commitment"
      ]
    },
    "target_state_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "before": {},
    "proposed_after": {},
    "transition_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "retain",
        "relapse",
        "revision",
        "strategy",
        "reset"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "canon_safe": {
      "type": "boolean",
      "default": false
    },
    "review_required": {
      "type": "boolean",
      "const": false
    }
  }
}