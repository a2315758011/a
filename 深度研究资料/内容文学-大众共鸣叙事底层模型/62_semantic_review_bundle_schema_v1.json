{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_review_bundle_v1",
  "title": "Semantic Review Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_reviews",
    "scene_reviews"
  ],
  "properties": {
    "candidate_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_review"
      }
    },
    "scene_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "decision",
          "confidence",
          "approved_reward_channels",
          "hook_valid",
          "state_change_candidate_ids",
          "reason",
          "review_required"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject",
              "escalate"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "approved_reward_channels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "C1_outcome",
                "C2_relationship",
                "C3_agency",
                "C4_meaning",
                "C5_competence"
              ]
            }
          },
          "reward_descriptions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "reward_magnitude": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "L1",
                "L2",
                "L3"
              ]
            }
          },
          "hook_valid": {
            "type": "boolean"
          },
          "hook_question": {
            "type": [
              "string",
              "null"
            ]
          },
          "state_change_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commitments_opened": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commitments_paid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "review_required": {
            "type": "boolean",
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "semantic_review": {
      "title": "Semantic Review Decision V1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "classification",
        "decision",
        "confidence",
        "target_domain",
        "target_state_id",
        "before",
        "proposed_after",
        "transition_class",
        "evidence",
        "reason"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "objective_fact",
            "character_belief",
            "misunderstanding",
            "emotion_only",
            "actual_state_change",
            "commitment",
            "no_state_change",
            "ambiguous"
          ]
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "escalate"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "target_domain": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "world",
            "knowledge",
            "boundary",
            "relationship",
            "competence",
            "identity",
            "resource",
            "arc",
            "commitment"
          ]
        },
        "target_state_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {},
        "proposed_after": {},
        "transition_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "retain",
            "relapse",
            "revision",
            "strategy",
            "reset"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "canon_safe": {
          "type": "boolean",
          "default": false
        },
        "review_required": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}